# ─── App ───────────────────────────────────────────────
ENVIRONMENT=development

# ─── Postgres ──────────────────────────────────────────
POSTGRES_USER=vectus
POSTGRES_PASSWORD=changeme_in_prod
POSTGRES_DB=vectus_scan
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis / Celery ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_DB=0
CELERY_RESULT_DB=1

# ─── Frontend (producción) ─────────────────────────────
FRONTEND_PORT=8080

# ─── Autenticación (F7) ────────────────────────────────
# Enforcement global. Dejar en false hasta que el login del front (F7b) esté
# desplegado; luego poner true.
AUTH_REQUIRED=false

# Pepper para hashear OTP y tokens de sesión. GENERAR uno propio en el server
# (p. ej.: python -c "import secrets; print(secrets.token_urlsafe(48))") y
# NO commitearlo. Este placeholder es solo para desarrollo local.
AUTH_PEPPER=change_me_generate_a_random_value

# Cookie de sesión. Poner SESSION_COOKIE_SECURE=true cuando haya HTTPS delante.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# SMTP (Gmail con app password). Si SMTP_USER/SMTP_APP_PASSWORD quedan vacíos,
# corre en modo bootstrap: el código se registra en el log del backend en vez
# de enviarse por correo. La app password va SOLO acá en el .env del server.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=Vectus SCAN <cuenta@gmail.com>

# Admin inicial (se siembra al arrancar si no hay usuarios).
ADMIN_EMAIL=
ADMIN_NAME=Administrador
